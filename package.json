{
  "name": "team-charlie-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
